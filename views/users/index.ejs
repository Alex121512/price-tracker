<% layout('layouts/boilerplate') %>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Users</h1>
        <a href="/users/new" class="btn btn-primary btn-sm">Add user</a>
    </div>

    <p class="text-body-secondary small">
        <%= users.length %>
            <%= users.length===1 ? 'user' : 'users' %>
    </p>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Username</th>
                    <th>Email</th>
                    <th style="min-width: 150px;">Role</th>
                    <th class="text-end"></th>
                </tr>
            </thead>
            <tbody>
                <% for (let u of users) { %>
                    <% const isMe=u._id.equals(currentUser._id); %>
                        <tr>
                            <td class="fw-semibold">
                                <%= u.username %>
                                    <% if (isMe) { %><span class="badge text-bg-info ms-1">You</span>
                                        <% } %>
                            </td>

                            <td>
                                <%= u.email %>
                            </td>

                            <td>
                                <% if (isMe) { %>
                                    <%= u.role %>
                                        <% } else { %>
                                            <form action="/users/<%= u._id %>/role?_method=PATCH" method="POST">
                                                <select name="role" class="form-select form-select-sm"
                                                    onchange="this.form.submit()">
                                                    <% for (let r of ROLES) { %>
                                                        <option value="<%= r %>" <%=u.role===r ? 'selected' : '' %>><%=
                                                                r %>
                                                        </option>
                                                        <% } %>
                                                </select>
                                            </form>
                                            <% } %>
                            </td>

                            <td class="text-end">
                                <% if (!isMe) { %>
                                    <form action="/users/<%= u._id %>?_method=DELETE" method="POST" class="d-inline"
                                        onsubmit="return confirm('Delete <%= u.username %>? This cannot be undone.');">
                                        <button class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                    <% } %>
                            </td>
                        </tr>
                        <% } %>
            </tbody>
        </table>
    </div>