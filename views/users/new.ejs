<% layout('layouts/boilerplate') %>

    <div class="row">
        <div class="col-md-6 offset-md-3">
            <h1 class="h3 mb-4">Add user</h1>
            <form action="/users/new" method="POST" class="validated-form" novalidate>
                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <input type="text" class="form-control" id="username" name="username" minlength="3" maxlength="30"
                        pattern="[A-Za-z0-9]+" title="Letters and numbers only, 3–30 characters" autocomplete="off"
                        required>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="form-text">3–30 characters, letters and numbers only (no spaces).</div>
                    <div class="invalid-feedback">Username must be 3–30 characters, using only letters and numbers.
                    </div>

                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input type="email" class="form-control" id="email" name="email" autocomplete="off" maxlength="254"
                        required>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">Enter a valid email address, e.g. name@company.com.</div>

                </div>
                <div class="mb-3">
                    <label for="role" class="form-label">Role</label>
                    <select class="form-select" id="role" name="role" required>
                        <% for (let r of ROLES) { %>
                            <option value="<%= r %>" <%=r==='rep' ? 'selected' : '' %>><%= r %>
                            </option>
                            <% } %>
                    </select>
                    <div class="valid-feedback">
                        Looks good!
                    </div>
                    <div class="invalid-feedback">User must have a Role.</div>
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Temporary password</label>
                    <input type="password" class="form-control" id="password" name="password"
                        autocomplete="new-password" minlength="8" required>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="form-text">At least 8 characters.</div>
                    <div class="invalid-feedback">Password must be at least 8 characters.</div>
                    <div class="form-text">Share it with the user privately.</div>
                </div>
                <button class="btn btn-primary">Create user</button>
            </form>
        </div>
    </div>