<% layout('layouts/boilerplate') %>
    <% const money=(n)=> new Intl.NumberFormat('en-CA', { style: 'currency', currency: 'CAD' }).format(n);
        const shortDate = (d) => d ? new Intl.DateTimeFormat('en-CA', { dateStyle: 'medium' }).format(d) : '';
        const updatedBy = (p) => p.lastUpdatedBy ? p.lastUpdatedBy.username : '—';
        %>

        <div class="mb-3">
            <h1 class="h3 mb-0">Price List</h1>
        </div>


        <form action="/products" method="GET" class="row g-2 mb-3" role="search">
            <div class="col-12 col-md-6">
                <input type="search" class="form-control" name="q" value="<%= q %>"
                    placeholder="Search name, code or description" autocomplete="off">
            </div>

            <div class="col-8 col-md-4">
                <select class="form-select" name="category" onchange="this.form.submit()">
                    <option value="">All categories</option>
                    <% for (let c of CATEGORIES) { %>
                        <option value="<%= c %>" <%=category===c ? 'selected' : '' %>><%= c %>
                        </option>
                        <% } %>
                </select>
            </div>

            <div class="col-4 col-md-2 d-grid">
                <button class="btn btn-primary">Search</button>
            </div>
        </form>

        <div class="d-flex justify-content-between align-items-center mb-2">
            <p class="text-body-secondary small mb-0">
                <%= products.length %>
                    <%= products.length===1 ? 'product' : 'products' %>
                        <% if (q || category) { %> found<% } %>
            </p>
            <% if (q || category) { %>
                <a href="/products" class="small">Clear filters</a>
                <% } %>
        </div>

        <!-- DESKTOP / TABLET: table -->
        <div class="table-responsive d-none d-md-block">
            <table class="table table-striped align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Tier 1</th>
                        <th>Tier 2</th>
                        <th>Tier 3</th>
                        <th>Tier 4</th>
                        <th>Tier 5</th>
                        <th class="text-end">Last updated</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <% for (let p of products) { %>
                        <tr>
                            <td><code><%= p.code %></code></td>
                            <td>
                                <div class="fw-semibold">
                                    <%= p.name %>
                                </div>
                                <% if (p.description) { %>
                                    <small class="text-muted d-block text-truncate" style="max-width: 280px;"
                                        title="<%= p.description %>">
                                        <%= p.description %>
                                    </small>
                                    <% } %>
                            </td>
                            <td>
                                <%= p.category %>
                            </td>
                            <% for (let i=1; i <=5; i++) { %>
                                <td class="price">
                                    <%= money(p.prices[`tier${i}`]) %>
                                </td>
                                <% } %>
                                    <td class="text-end small text-nowrap">
                                        <div>
                                            <%= updatedBy(p) %>
                                        </div>
                                        <div class="text-body-secondary">
                                            <%= shortDate(p.updatedAt) %>
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <a href="/products/<%= p._id %>" class="btn btn-outline-primary btn-sm">View</a>
                                    </td>
                        </tr>
                        <% } %>
                </tbody>
            </table>
        </div>

        <!-- PHONE: cards -->
        <div class="d-md-none">
            <% for (let p of products) { %>
                <a href="/products/<%= p._id %>" class="card mb-2 text-decoration-none text-body">
                    <div class="card-body p-3 ">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div class="fw-semibold">
                                <%= p.name %>
                            </div>
                            <code class="small text-nowrap"><%= p.code %></code>
                        </div>
                        <div class="text-muted small mb-2">
                            <%= p.category %>
                        </div>

                        <div class="row row-cols-3 row-cols-sm-5 g-2 text-center">
                            <% for (let i=1; i <=5; i++) { %>
                                <div class="col">
                                    <div class="tier-label">T<%= i %>
                                    </div>
                                    <div class="price small fw-semibold">
                                        <%= money(p.prices[`tier${i}`]) %>
                                    </div>
                                </div>
                                <% } %>
                        </div>
                        <div class="text-body-secondary small mt-2">
                            Updated <%= shortDate(p.updatedAt) %> by <%= updatedBy(p) %>
                        </div>
                    </div>
                </a>
                <% } %>
        </div>

        <% if (!products.length) { %>
            <p class="text-muted">No products found.</p>
            <% } %>
                </div>