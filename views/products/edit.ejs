<% layout('layouts/boilerplate') %>

    <div class="row">
        <div class="col-md-10 offset-md-1 col-lg-8 offset-lg-2">

            <h1 class="h3 mt-3 mb-4">Edit product</h1>

            <form action="/products/<%=product._id%>?_method=PUT" method="POST" class="validated-form" novalidate>

                <div class="mb-3">
                    <label for="name" class="form-label">Name</label>
                    <input type="text" class="form-control" id="name" name="product[name]" value="<%=product.name%>"
                        required>
                    <div class="invalid-feedback">Name is required.</div>
                    <div class="valid-feedback">
                        Looks good!
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="code" class="form-label">Code</label>
                        <input type="text" class="form-control text-uppercase" id="code" name="product[code]"
                            value="<%=product.code%>" required>
                        <div class="invalid-feedback">Code is required.</div>
                        <div class="valid-feedback">
                            Looks good!
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="category" class="form-label">Category</label>
                        <select class="form-select" id="category" name="product[category]" required>
                            <option value="" disabled>Choose...</option>
                            <% for (let c of CATEGORIES) { %>
                                <option value="<%= c %>" <%=product.category===c ? 'selected' : '' %>><%= c %>
                                </option>
                                <% } %>
                        </select>
                        <div class="invalid-feedback">Choose a category.</div>
                        <div class="valid-feedback">
                            Looks good!
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label for="description" class="form-label">Description <span
                            class="text-muted">(optional)</span></label>
                    <textarea class="form-control" id="description" name="product[description]" rows="3"
                        required><%=product.description%></textarea>
                    <div class="invalid-feedback">Product must have a description.</div>
                    <div class="valid-feedback">
                        Looks good!
                    </div>
                </div>

                <h2 class="h5">Price tiers</h2>
                <p class="text-muted small">Tier 1 is the floor (lowest), Tier 5 is the list price (highest). Each tier
                    must be equal to or higher than the one before.</p>

                <div class="row g-3 mb-4">
                    <% for (let i=1; i <=5; i++) { %>
                        <div class="col-6 col-md">
                            <label for="tier<%= i %>" class="form-label">
                                Tier <%= i %>
                                    <% if (i===1) { %><span class="badge text-bg-warning">Floor</span>
                                        <% } %>
                                            <% if (i===5) { %><span class="badge text-bg-success">List</span>
                                                <% } %>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" id="tier<%= i %>"
                                    name="product[prices][tier<%= i %>]" min="0" step="0.01"
                                    value="<%=product.prices[`tier${i}`]%>" placeholder="0.00" required>
                                <div class="invalid-feedback">Enter a price of 0 or more.</div>
                                <div class="valid-feedback">
                                    Looks good!
                                </div>
                            </div>
                        </div>
                        <% } %>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary">Edit product</button>
                    <a href="/products/<%=product._id%>" class="btn btn-outline-secondary">Cancel</a>
                </div>

            </form>
        </div>
    </div>