<% layout('layouts/boilerplate')%>
    <div class="container my-4" style="max-width: 760px;">

        <div class="card mt-3 shadow-sm">
            <div class="card-body">

                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <div>
                        <h1 class="h3 mb-1">
                            <%= product.name %>
                        </h1>
                        <span class="badge text-bg-secondary">
                            <%= product.category %>
                        </span>
                        <code class="ms-2"><%= product.sku %></code>
                    </div>
                </div>

                <% if (product.description) { %>
                    <p class="mt-3 mb-0">
                        <%= product.description %>
                    </p>
                    <% } else { %>
                        <p class="mt-3 mb-0 text-muted fst-italic">No description.</p>
                        <% } %>

                            <h2 class="h5 mt-4">Price tiers</h2>
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Tier</th>
                                        <th class="text-end">Price</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% for (let i=1; i <=5; i++) { %>
                                        <tr>
                                            <td>
                                                Tier <%= i %>
                                                    <% if (i===1) { %><span
                                                            class="badge text-bg-warning ms-1">Floor</span>
                                                        <% } %>
                                                            <% if (i===5) { %><span
                                                                    class="badge text-bg-success ms-1">List</span>
                                                                <% } %>
                                            </td>
                                            <td class="text-end fw-semibold">$<%= product.prices[`tier${i}`].toFixed(2)
                                                    %>
                                            </td>
                                        </tr>
                                        <% } %>
                                </tbody>
                            </table>

            </div>

            <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
                <small class="text-body-secondary">
                    <% if (product.updatedAt) { %>
                        Last updated <%= product.updatedAt.toLocaleString('en-CA', { dateStyle: 'medium' ,
                            timeStyle: 'short' }) %>
                            by <%= product.lastUpdatedBy ? product.lastUpdatedBy.username : '—' %>
                                <% } %>
                </small>

                <div class="d-flex gap-2">
                    <% if (currentUser.role==='admin' || currentUser.role==='manager' ) { %>
                        <a href="/products/<%=product._id%>/edit" class="btn btn-outline-info btn-sm">Edit</a>
                        <form action="/products/<%= product._id %>?_method=DELETE" method="POST"
                            onsubmit="return confirm('Delete <%= product.code %>?');">
                            <button class="btn btn-outline-danger btn-sm">Delete</button>
                        </form>
                        <% } %>
                </div>
            </div>
        </div>

    </div>