<% layout('layouts/boilerplate')%>

    <div class="container my-3">
        <h1 class="mb-3">Price List</h1>
        <a href="/products/new" class="btn btn-outline-primary btn-sm mb-1">
            Add new
        </a>
        <p class="text-muted">
            <%= products.length %> products
        </p>

        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>SKU</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th class="text-end">Tier 1</th>
                        <th class="text-end">Tier 2</th>
                        <th class="text-end">Tier 3</th>
                        <th class="text-end">Tier 4</th>
                        <th class="text-end">Tier 5</th>
                        <th class="text-center">Controls</th>
                    </tr>
                </thead>
                <tbody>
                    <% for (let p of products) { %>
                        <tr>
                            <td><code><%= p.code %></code></td>
                            <td>
                                <div class="fw-semibold">
                                    <%= p.name %>
                                </div>
                                <% if (p.description) { %>
                                    <small class="text-muted d-block text-truncate" style="max-width: 280px;"
                                        title="<%= p.description %>">
                                        <%= p.description %>
                                    </small>
                                    <% } %>
                            </td>
                            <td>
                                <%= p.category %>
                            </td>
                            <td class="text-end">$<%= p.prices.tier1.toFixed(2) %>
                            </td>
                            <td class="text-end">$<%= p.prices.tier2.toFixed(2) %>
                            </td>
                            <td class="text-end">$<%= p.prices.tier3.toFixed(2) %>
                            </td>
                            <td class="text-end">$<%= p.prices.tier4.toFixed(2) %>
                            </td>
                            <td class="text-end">$<%= p.prices.tier5.toFixed(2) %>
                            </td>
                            <td class="text-center">
                                <a href="/products/<%= p._id %>" class="btn btn-outline-primary btn-sm mb-1">
                                    View
                                </a>
                                <!-- <a href="/products/<%= p._id %>" class="btn btn-outline-primary btn-sm mb-1">
                                Edit
                            </a>
                            <a href="/products/<%= p._id %>" class="btn btn-outline-danger btn-sm mb-1">
                                Delete -->
                                </a>
                            </td>
                        </tr>
                        <% } %>
                </tbody>
            </table>
        </div>

        <% if (!products.length) { %>
            <p class="text-muted">No products yet. Run the seed file first.</p>
            <% } %>
    </div>