<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Price List</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
    <div class="container my-4">
        <h1 class="mb-3">Price List</h1>
        <p class="text-muted">
            <%= products.length %> products
        </p>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>SKU</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th class="text-end">Tier 1</th>
                        <th class="text-end">Tier 2</th>
                        <th class="text-end">Tier 3</th>
                        <th class="text-end">Tier 4</th>
                        <th class="text-end">Tier 5</th>
                    </tr>
                </thead>
                <tbody>
                    <% for (let p of products) { %>
                        <tr>
                            <td><code><%= p.code %></code></td>
                            <td>
                                <div class="fw-semibold">
                                    <%= p.name %>
                                </div>
                                <% if (p.description) { %>
                                    <small class="text-muted d-block text-truncate" style="max-width: 280px;"
                                        title="<%= p.description %>">
                                        <%= p.description %>
                                    </small>
                                    <% } %>
                            </td>
                            <td>
                                <%= p.category %>
                            </td>
                            <td class="text-end">$<%= p.prices.tier1.toFixed(2) %>
                            </td>
                            <td class="text-end">$<%= p.prices.tier2.toFixed(2) %>
                            </td>
                            <td class="text-end">$<%= p.prices.tier3.toFixed(2) %>
                            </td>
                            <td class="text-end">$<%= p.prices.tier4.toFixed(2) %>
                            </td>
                            <td class="text-end">$<%= p.prices.tier5.toFixed(2) %>
                            </td>
                        </tr>
                        <% } %>
                </tbody>
            </table>
        </div>

        <% if (!products.length) { %>
            <p class="text-muted">No products yet. Run the seed file first.</p>
            <% } %>
    </div>
</body>

</html>