<% layout('layouts/boilerplate') %>
    <div class="row">
        <div class="col-md-10 offset-md-1 col-lg-8 offset-lg-2">
            <div class="alert alert-danger" role="alert">
                <h4 class="alert-heading text-break">
                    <%= err.message %>
                </h4>
                <% if (err.stack) { %>
                    <pre class="small mb-0"
                        style="white-space: pre-wrap; word-break: break-word;"><%= err.stack %></pre>
                    <% } %>
            </div>
        </div>
    </div>